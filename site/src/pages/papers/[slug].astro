---
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import { loadPapers } from '../../lib/papers.js';

export async function getStaticPaths() {
  const contentRoot = path.resolve(process.cwd(), '../knowledge2deck');
  const papers = loadPapers(contentRoot);
  return papers.map((paper) => ({ params: { slug: paper.slug }, props: { paper } }));
}

interface Props {
  paper: {
    slug: string;
    title: string;
    url: string;
    authors: string;
    abstract: string;
    dateAdded: string;
    category: string;
    file: string;
    hasSlides: boolean;
  };
}
const { paper } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={`${paper.title} — Knowledge2Deck`} description={paper.abstract.slice(0, 150)}>
  <a href={`${base}/`} class="text-xs text-neutral-500 hover:text-neutral-300">← 목록</a>

  <article class="mt-4">
    <h1 class="text-2xl font-semibold leading-snug text-white">{paper.title}</h1>

    <p class="mt-3 text-sm text-neutral-400">{paper.authors || '저자 정보 없음'}</p>

    <p class="mt-2 text-xs text-neutral-500">
      추가일 {paper.dateAdded} · {paper.category}
      {paper.hasSlides && <span class="ml-1 text-emerald-400">slides 있음</span>}
    </p>

    <div class="mt-4 flex gap-3">
      <a
        href={paper.url}
        target="_blank"
        rel="noopener"
        class="rounded-md bg-white px-4 py-2 text-sm font-medium text-black transition-colors duration-150 hover:bg-neutral-200"
      >
        원문 보기 ↗
      </a>
      {
        paper.hasSlides && (
          <a
            href={`${base}/slides/${paper.slug}.html`}
            target="_blank"
            rel="noopener"
            class="rounded-md border border-neutral-700 px-4 py-2 text-sm font-medium text-emerald-400 transition-colors duration-150 hover:bg-[#141414]"
          >
            슬라이드 보기
          </a>
        )
      }
    </div>

    {
      paper.abstract && (
        <section class="mt-8">
          <h2 class="mb-2 text-sm font-medium text-neutral-400">Abstract</h2>
          <p class="text-sm leading-relaxed text-neutral-300">{paper.abstract}</p>
        </section>
      )
    }

    <p class="mt-10 text-xs text-neutral-500">source: knowledge2deck/{paper.file}</p>
  </article>
</Base>
