---
interface Props {
  paper: {
    slug: string;
    title: string;
    authors: string;
    abstract: string;
    dateAdded: string;
    category: string;
    hasSlides: boolean;
  };
}
const { paper } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<li
  class="paper-row rounded-md border border-neutral-800 p-4 transition-colors duration-150 hover:bg-[#141414]"
  data-search={`${paper.title} ${paper.authors} ${paper.abstract}`.toLowerCase()}
  data-category={paper.category}
  data-slides={paper.hasSlides ? 'y' : 'n'}
>
  <a href={`${base}/papers/${paper.slug}/`} class="block">
    <h3 class="text-base font-medium text-white">{paper.title}</h3>
    <p class="mt-1 text-xs text-neutral-400">
      {paper.authors || '—'}
    </p>
    <p class="mt-1 text-xs text-neutral-500">
      {paper.dateAdded}
      {paper.category === 'tech-report' && <span class="ml-2 text-neutral-400">tech report</span>}
      {paper.hasSlides && <span class="ml-2 text-emerald-400">slides</span>}
    </p>
  </a>
</li>
