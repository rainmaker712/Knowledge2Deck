---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'AI 리서치 페이퍼 아카이브' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen antialiased">
    <div class="mx-auto max-w-4xl px-4 py-8">
      <header class="mb-8 flex items-baseline justify-between border-b border-neutral-800 pb-4">
        <a href={base} class="text-lg font-semibold text-white hover:text-neutral-200"
          >Knowledge2Deck</a
        >
        <span class="text-xs text-neutral-500">AI paper archive</span>
      </header>
      <main>
        <slot />
      </main>
      <footer class="mt-16 border-t border-neutral-800 pt-4 text-xs text-neutral-500">
        Built from markdown · <a
          href="https://github.com/"
          class="text-neutral-400 hover:text-neutral-300">GitHub</a
        >
      </footer>
    </div>
  </body>
</html>
